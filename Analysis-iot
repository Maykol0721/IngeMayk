        "import seaborn as sns\n",
        "\n",
        "# Initialize lists to store model names and their corresponding performance metrics\n",
        "model_names = []\n",
        "accuracy_scores = []\n",
        "precision_scores = []\n",
        "recall_scores = []\n",
        "f1_scores = []\n",
