        "    print(f\"Precision: {precision:.4f}\")\n",
        "    print(f\"Recall: {recall:.4f}\")\n",
        "    print(f\"F1-Score: {f1:.4f}\")\n",
        "\n",
        "    # Generate and visualize confusion matrix\n",
        "    cm = confusion_matrix(y_test_encoded, y_pred)\n",
        "    plt.figure(figsize=(10, 8))\n",
